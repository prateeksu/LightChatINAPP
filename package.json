{
  "name": "lightchat-inapp",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight React video meeting app with Express, Socket.IO, and peer-to-peer WebRTC.",
  "scripts": {
    "start": "node server-express.js",
    "dev": "concurrently -k -n signaling,web \"node server-express.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "vite": "^8.3.6"
  }
}
